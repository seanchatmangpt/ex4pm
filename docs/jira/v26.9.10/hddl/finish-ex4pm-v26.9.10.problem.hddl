(define (problem finish-ex4pm-v26-9-10-2026-09-09)
  (:domain finish-ex4pm-v26-9-10)

  (:objects
    ex4pm-standing-coded - module
    ex4pm-evidence-batch - module
    ex4pm-git-containment - module
    ex4pm-consumer-mining-doc - module
    ex4pm-hexdocs - doc
    ex4pm-consumer-how-to-guides - doc
  )

  (:htn
