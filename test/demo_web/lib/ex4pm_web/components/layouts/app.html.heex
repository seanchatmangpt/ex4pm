<header class="border-b border-gray-800 bg-[#0e1424] px-6 py-4">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <div class="flex items-center space-x-4">
      <div class="flex items-center space-x-2">
        <span class="inline-block w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="font-mono text-xl font-bold tracking-tight text-emerald-400">ex4pm</span>
      </div>
      <span class="text-xs uppercase tracking-widest px-2.5 py-0.5 rounded-full bg-emerald-950 text-emerald-300 border border-emerald-800">
        Control Plane
      </span>
    </div>
    <nav class="flex items-center space-x-5 text-sm font-medium">
      <a href="/dashboard" class="text-sky-400 hover:text-sky-300 transition flex items-center gap-1.5 font-semibold">
        <span>⚡</span> Living Dashboard
      </a>
      <a href="/powl-miner" class="text-indigo-400 hover:text-indigo-300 transition flex items-center gap-1.5">
        <span>🧭</span> POWL Miner 2.0
      </a>
      <a href="/process-intelligence/live" class="text-emerald-400 hover:text-emerald-300 transition flex items-center gap-1.5">
        <span>📡</span> Live Stream
      </a>
      <a href="/admin" class="text-amber-400 hover:text-amber-300 transition flex items-center gap-1.5">
        <span>🗄️</span> AshAdmin
      </a>
      <a href="/healthz" class="text-gray-400 hover:text-gray-200 transition">
        Probe
      </a>
    </nav>
  </div>
</header>

<main class="max-w-7xl mx-auto px-6 py-8">
  <%= @inner_content %>
</main>
