<%
# ggen_igniter EEx template -> lib/ex4pm_engine/wasm/algo_registry.ex
#
# Bindings (from `--query algorithms=priv/ggen/queries/registered_algorithms.rq`):
#   algorithms - list of string-keyed maps: "algorithm_id", "module_name",
#                "export_name", "replay_export_name", "standing"
#
# Rows are re-sorted here (row order from the engine is never trusted).
rows = Enum.sort_by(algorithms, & &1["algorithm_id"])

spec_src =
  Enum.map_join(rows, ",\n", fn r ->
    """
        %{
          module: Ex4pmEngine.Wasm.#{r["module_name"]},
          algorithm_id: :#{r["algorithm_id"]},
          export_name: #{inspect(r["export_name"])},
          replay_export_name: #{inspect(r["replay_export_name"])},
          standing: #{inspect(r["standing"])}
        }\
    """
  end)

count = length(rows)

rank = fn r -> r["engine_rank"] |> to_string() |> String.to_integer() end
ranked = Enum.sort_by(rows, rank)
ranks = Enum.map(ranked, rank)
true = ranks == Enum.uniq(ranks)

rank_src =
  Enum.map_join(ranked, ",\n", fn r ->
    "    {Ex4pmEngine.Wasm.#{r["module_name"]}, #{rank.(r)}}"
  end)
%># GENERATED by ggen_igniter from the admitted ex4pmal:RegisteredAlgorithm graph. Do not edit.
defmodule Ex4pmEngine.Wasm.AlgoRegistry do
  @moduledoc """
  Generated registry of the <%= count %> WASM-backed algorithm adapters.

  Source of truth: `epm:AlgorithmBinding` individuals in the vendored
  `ex4pm-wasm4pm-bindings-pack` plus one `ex4pmal:RegisteredAlgorithm` per
  algorithm in `priv/ontology/ex4pm.ttl`, merged by
  `mix ex4pm.ggen.sync` (unit `algo_registry`). To add or change an entry,
  edit the ontology/pack and re-run the sync; see
  `docs/ALGORITHM-REGISTRY-GENERATION.md`.

  Each spec carries the evidentiary `standing` rung (name of one of the 10
  `standing-ladder-pack` states, as a string) the registration is gated at.
  It is NOT an `Ex4pm.Standing` atom and is deliberately unmapped to it.
  """

  @type spec :: %{
          module: module(),
          algorithm_id: atom(),
          export_name: String.t(),
          replay_export_name: String.t(),
          standing: String.t()
        }

  @specs [
<%= spec_src %>
  ]

  @doc "All registered algorithms, ordered by `algorithm_id`."
  @spec algo_specs() :: [spec()]
  def algo_specs, do: @specs

  @doc "All registered `algorithm_id` atoms, in registry order."
  @spec algorithm_ids() :: [atom()]
  def algorithm_ids, do: Enum.map(@specs, & &1.algorithm_id)

  @engine_ranks [
<%= rank_src %>
  ]

  @doc """
  Adapter modules paired with their explicit `Ex4pm.Engine.Registry`
  selection rank (from `ex4pmal:engineRank`), ordered by ascending rank.
  """
  @spec engine_ranks() :: [{module(), non_neg_integer()}]
  def engine_ranks, do: @engine_ranks

  @doc "Adapter modules in engine-registry rank order."
  @spec engine_modules() :: [module()]
  def engine_modules, do: Enum.map(@engine_ranks, &elem(&1, 0))
end
