<%
# ggen_igniter EEx template -> test/standing_coded_test.exs
#
# Bindings (same query as standing_coded.ex.eex):
#   admitted - list of string-keyed maps: "standing", "code"
#
# One real round-trip test per admitted STANDING[CODE] example, generated
# directly from ontology facts -- grows automatically when a new
# ex4pmsc:AdmittedStandingCode individual is admitted, no hand-written
# test needed.
norm = fn
  nil ->
    nil

  v when is_binary(v) ->
    cond do
      String.starts_with?(v, "<") and String.ends_with?(v, ">") ->
        String.slice(v, 1..-2//1)

      String.starts_with?(v, "\"") ->
        case Regex.run(~r/\A"(.*)"(?:\^\^<[^>]*>|@[A-Za-z0-9\-]+)?\z/s, v) do
          [_, lex] -> lex
          nil -> v
        end

      true ->
        v
    end

  v ->
    to_string(v)
end

admitted_rows =
  admitted
  |> Enum.map(fn a -> %{standing: norm.(a["standing"]), code: norm.(a["code"])} end)
  |> Enum.sort_by(&{&1.standing, &1.code})

test_cases =
  Enum.map_join(admitted_rows, "\n\n", fn a ->
    expected = "#{String.upcase(a.standing)}[#{a.code}]"

    """
      test #{inspect("round-trips the real production example #{expected}")} do
        coded = Coded.new(#{inspect(String.to_atom(a.standing))}, #{inspect(a.code)})
        assert Coded.to_string(coded) == #{inspect(expected)}
        assert Coded.parse(#{inspect(expected)}) == {:ok, coded}
      end
    """
  end)
%># GENERATED by ggen_igniter from the admitted ex4pmsc:AdmittedStandingCode graph. Do not edit.
defmodule Ex4pm.Standing.CodedTest do
  use ExUnit.Case, async: true

  alias Ex4pm.Standing.Coded

<%= test_cases %>
  test "bare standing (no code) renders and parses without brackets" do
    coded = Coded.new(:alive)
    assert Coded.to_string(coded) == "ALIVE"
    assert Coded.parse("ALIVE") == {:ok, coded}
  end

  test "parse/1 refuses a malformed string, never crashes" do
    assert Coded.parse("not a valid standing string!!!") == :error
  end

  test "rank/1 dispatches through Ex4pm.Standing.rank/1 for both bare atoms and coded structs" do
    coded = Coded.new(:alive, "SOME_CODE")
    assert Coded.rank(coded) == Ex4pm.Standing.rank(:alive)
    assert Coded.rank(:alive) == Ex4pm.Standing.rank(:alive)
  end

  test "min/2 picks the lower-ranked of two coded standings, keeping its own code" do
    blocked = Coded.new(:blocked, "SOME_CODE")
    alive = Coded.new(:alive, "OTHER_CODE")
    assert Coded.min(blocked, alive) == blocked
  end
end
