<%
# ggen_igniter EEx template -> test/algo_registry_test.exs
#
# Same `algorithms` query as algo_registry.ex.eex. The expected id list is
# embedded from the ontology rows, so the test pins the generated registry
# against the graph it came from.
rows = Enum.sort_by(algorithms, & &1["algorithm_id"])
count = length(rows)
ids = Enum.map_join(rows, ",\n", fn r -> "      :#{r["algorithm_id"]}" end)
standings = rows |> Enum.map(& &1["standing"]) |> Enum.uniq() |> Enum.sort() |> Enum.join(", ")
%># GENERATED by ggen_igniter from the admitted ex4pmal:RegisteredAlgorithm graph. Do not edit.
defmodule Ex4pmEngine.Wasm.AlgoRegistryTest do
  use ExUnit.Case, async: true

  alias Ex4pmEngine.Wasm.{AlgoRegistry, RealTransport}

  @expected_ids [
<%= ids %>
  ]

  @ladder ~w(UNKNOWN OBSERVED VALIDATED DERIVED CANDIDATE EXPERIMENTALLY_SUPPORTED ADMITTED
             MANUFACTURED ACTUATED VERIFIED)

  test "registry count equals the ontology's registered-algorithm rows (<%= count %>)" do
    assert length(AlgoRegistry.algo_specs()) == <%= count %>
    assert AlgoRegistry.algorithm_ids() == @expected_ids
  end

  test "algorithm ids are unique and sorted" do
    ids = AlgoRegistry.algorithm_ids()
    assert ids == Enum.uniq(ids)
    assert ids == Enum.sort(ids)
  end

  test "every registered module is loadable and declares the registered export names" do
    for spec <- AlgoRegistry.algo_specs() do
      assert Code.ensure_loaded?(spec.module), "#{inspect(spec.module)} is not loadable"
      assert function_exported?(spec.module, :wasm_export, 0)
      assert spec.module.wasm_export() == spec.export_name
      assert spec.module.wasm_replay_export() == spec.replay_export_name
      assert spec.export_name == "wasm4pm_ex4pm_#{spec.algorithm_id}_v1"
      assert spec.replay_export_name == "wasm4pm_ex4pm_#{spec.algorithm_id}_replay_v1"
      assert spec.module.supports?(spec.algorithm_id, [])
    end
  end

  test "every spec standing is a rung of the 10-state ladder (found among <%= standings %>)" do
    for spec <- AlgoRegistry.algo_specs(), do: assert(spec.standing in @ladder)
  end

  test "every adapter module on disk is registered (registration is not the module count)" do
    on_disk =
      "lib/ex4pm_engine/wasm/*.ex"
      |> Path.wildcard()
      |> Enum.filter(&(File.read!(&1) =~ ~r/^\s*use Ex4pmEngine\.Wasm\.Adapter,/m))
      |> Enum.map(&(&1 |> Path.basename(".ex") |> String.to_atom()))
      |> Enum.sort()

    assert on_disk == Enum.sort(AlgoRegistry.algorithm_ids())
  end

  test "registry agrees with RealTransport.algo_specs/0 on module and export names" do
    take = &Map.take(&1, [:module, :algorithm_id, :export_name, :replay_export_name])

    assert AlgoRegistry.algo_specs() |> Enum.map(take) |> Enum.sort_by(& &1.algorithm_id) ==
             RealTransport.algo_specs() |> Enum.map(take) |> Enum.sort_by(& &1.algorithm_id)
  end

  test "engine registry candidate ids are exactly the registered algorithms (+ non-algorithm engines)" do
    algo_engine_ids = Enum.map(AlgoRegistry.algo_specs(), &:"wasm_#{&1.algorithm_id}")
    registry_ids = Enum.map(Ex4pm.Engine.Registry.engines(), & &1.id())

    assert Enum.sort(algo_engine_ids -- registry_ids) == []
    assert Enum.sort(Enum.filter(registry_ids, &String.starts_with?(to_string(&1), "wasm_"))) ==
             Enum.sort(algo_engine_ids ++ [:wasm_remote])

    assert Enum.map(AlgoRegistry.engine_modules(), & &1.id()) |> Enum.sort() ==
             Enum.sort(algo_engine_ids)

    ranks = Enum.map(AlgoRegistry.engine_ranks(), &elem(&1, 1))
    assert ranks == Enum.sort(Enum.uniq(ranks))
    assert Enum.take(Ex4pm.Engine.Registry.engines(), length(algo_engine_ids)) ==
             AlgoRegistry.engine_modules()
  end

  test "every registered algorithm id is an Engine.candidates/1 operation with a supporting engine" do
    for id <- AlgoRegistry.algorithm_ids() do
      engine_id = :"wasm_#{id}"
      candidates = Ex4pm.Engine.candidates(id)
      assert Enum.any?(candidates, &(&1.id == engine_id and &1.standing != :unsupported)),
             "no supporting candidate for #{inspect(id)}"
    end
  end
end
