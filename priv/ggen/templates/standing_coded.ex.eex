defmodule Ex4pm.Standing.Coded do
  @moduledoc """
  GENERATED by `mix ex4pm.ggen.verify_determinism` / `Ex4pm.Ggen.Generator`.
  Source ontology: <%= @ontology_source %> (sha256 <%= @ontology_hash %>)
  Source queries: <%= inspect(@query_sources) %> (sha256 <%= @queries_hash %>)

  Do not hand-edit -- regenerate via `Ex4pm.Ggen.Generator.render/2` from the source
  ontology instead. This module exists so `mix ex4pm.ggen.verify_determinism` has a
  real generation unit to prove regeneration is byte-identical.
  """

  @standings [<%= Enum.map_join(@standings, ", ", &(":" <> &1)) %>]

  @doc "The typed evidence/standing vocabulary admitted by the ontology, as atoms."
  @spec standings() :: [atom()]
  def standings, do: @standings

  @doc "The ontology's sha256 this module was generated from, for drift detection."
  @spec ontology_hash() :: String.t()
  def ontology_hash, do: <%= inspect(@ontology_hash) %>
end
