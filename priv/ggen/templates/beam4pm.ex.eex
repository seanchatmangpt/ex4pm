<%
# ggen_igniter EEx template -> lib/ex4pm/engine/beam4pm.ex
#
# Bindings (from `mix ggen_igniter.sync
#   --query admitted=priv/ggen/queries/admitted_beam4pm_services.rq`):
#   admitted - list of string-keyed maps: "operation", "jsonApiType", "actionName", "httpMethod"
#
# No term normalization here: as of ggen_igniter v26.8.27, --engine
# oxigraph (the default, and the only engine this repo's sync scripts
# use) returns plain unwrapped values by default -- see
# standing_coded.ex.eex's own header comment for the fuller finding.

admitted_rows =
  admitted
  |> Enum.map(fn a ->
    %{
      operation: a["operation"],
      json_api_type: a["jsonApiType"],
      action_name: a["actionName"],
      http_method: a["httpMethod"]
    }
  end)
  |> Enum.sort_by(& &1.operation)

route_table_doc =
  Enum.map_join(admitted_rows, "\n", fn r ->
    "    * `:#{r.operation}` -> `#{r.http_method} /#{r.json_api_type}` (action `#{r.action_name}`)"
  end)

route_table_entries =
  Enum.map_join(admitted_rows, ",\n", fn r ->
    "    #{inspect(String.to_atom(r.operation))} => %{json_api_type: #{inspect(r.json_api_type)}, action: #{inspect(r.action_name)}, http_method: #{inspect(String.to_atom(String.downcase(r.http_method)))}}"
  end)
%># GENERATED by ggen_igniter from the admitted ex4pmb:AdmittedBeam4pmService graph. Do not edit.
defmodule Ex4pm.Engine.Beam4pm do
  @moduledoc """
  Zero-config beam4pm engine candidate: connects to beam4pm as a generic
  Ash JSON:API client. "Zero config" means the ROUTE TABLE below is
  entirely admitted-ontology data (`priv/ontology/ex4pm.ttl`'s
  `ex4pmb:AdmittedBeam4pmService` graph) -- adding a new operation this
  engine can reach is a new ontology individual plus `mix ex4pm.ggen.sync`,
  never new hand-written dispatch code. See
  `docs/EX4PM-THINNING-BEAM4PM-ENRICHMENT.md` for the full migration this
  serves.

  Configure with `beam4pm_base_url: "http://host:port"` in opts (or
  `Application.put_env(:ex4pm, :beam4pm_base_url, ...)`). No per-operation
  configuration is needed or accepted -- the route table is fixed at
  generation time from the ontology.

  Admitted operations this engine currently supports:

  <%= route_table_doc %>

  ## Honest status

  As of this generation, beam4pm does not yet mount a live AshJsonApi
  router (see the `ex4pmb:` prefix comment in `priv/ontology/ex4pm.ttl`
  for the exact verification). This module's HTTP mechanics are real and
  tested against a real local JSON:API-shaped server
  (`test/engine_beam4pm_test.exs`); connecting it to a real beam4pm
  instance is gated on that separate, disclosed prerequisite.
  """
  @behaviour Ex4pm.Engine

  alias Ex4pm.Engine.Result
  alias Ex4pm.Refusal

  @route_table %{
<%= route_table_entries %>
  }

  @impl true
  def id, do: :beam4pm

  @impl true
  def supports?(operation, _opts), do: Map.has_key?(@route_table, operation)

  @impl true
  def available?(opts) do
    supports_any? = map_size(@route_table) > 0
    supports_any? and is_binary(base_url(opts))
  end

  @impl true
  def execute(operation, subject, opts) do
    with %{json_api_type: type, action: action, http_method: method} <-
           Map.get(@route_table, operation) ||
             {:error,
              Refusal.new(:beam4pm_unsupported_operation, "beam4pm has no admitted route for this operation",
                details: %{operation: operation}
              )},
         base when is_binary(base) <-
           base_url(opts) ||
             {:error,
              Refusal.new(:beam4pm_unavailable, "no beam4pm_base_url configured", details: %{operation: operation})},
         {:ok, response} <- request(base, type, action, method, subject, opts) do
      {:ok,
       %Result{
         engine: :beam4pm,
         operation: operation,
         algorithm: :ash_json_api,
         subject_hash: Ex4pm.Core.Hash.digest(subject),
         standing: standing_for(response),
         value: Map.get(response, "data"),
         evidence: %{
           executed: true,
           transport: :https,
           json_api_type: type,
           action: action,
           http_method: method,
           beam4pm_identity: identity_from(response)
         }
       }}
    end
  end

  defp base_url(opts) do
    Keyword.get(opts, :beam4pm_base_url) || Application.get_env(:ex4pm, :beam4pm_base_url)
  end

  # Real bug fix (found by an adversarial failure-path audit, not by
  # inspection alone): neither Req nor Finch enforces any receive timeout
  # by default -- a real slow/unresponsive server was verified to hang a
  # real caller indefinitely rather than ever reaching the
  # `%{reason: :timeout}` clause below. A bounded default (configurable via
  # `beam4pm_receive_timeout` in opts) is required for that clause to be
  # reachable in practice, not just in a unit test that sets it explicitly.
  @default_receive_timeout_ms 15_000

  # Real request shape, corrected 2026-09-09 against a real AshJsonApi
  # resource + AshJsonApi.Router (test/support/micro_beam4pm.ex), not
  # assumed: AshJsonApi routes are METHOD + PATH, e.g. `index :read` with
  # `base "/ocel_event"` produces a plain `GET /ocel_event` with NO
  # `action` query parameter -- the route itself already implies the
  # action, the same way `get`/`post` HTTP verbs already imply CRUD intent
  # in any REST API. The earlier `action`/`subject_hash` query params were
  # an unverified assumption about the wire shape; both are dropped now
  # that a real AshJsonApi instance proved they were never part of the
  # real contract. `action` is still threaded through for evidence/logging
  # only, not sent over the wire.
  defp request(base, type, _action, method, _subject, opts) do
    http_module = Keyword.get(opts, :beam4pm_http_module, Req)
    url = Path.join(base, "/#{type}")
    receive_timeout = Keyword.get(opts, :beam4pm_receive_timeout, @default_receive_timeout_ms)

    result =
      case method do
        :get -> http_module.get(url, retry: false, receive_timeout: receive_timeout)
        :post -> http_module.post(url, json: %{}, retry: false, receive_timeout: receive_timeout)
      end

    case result do
      {:ok, %{status: status, body: body}} when status in 200..299 and is_map(body) ->
        {:ok, body}

      {:ok, %{status: status, body: body}} when status in 200..299 ->
        {:error,
         Refusal.new(:beam4pm_invalid_response, "beam4pm returned a 2xx status but a non-JSON-object body",
           details: %{status: status, url: url, body: inspect(body)}
         )}

      {:ok, %{status: status}} ->
        {:error,
         Refusal.new(:beam4pm_http_error, "beam4pm returned a non-2xx status",
           details: %{status: status, url: url}
         )}

      {:error, %{reason: :timeout}} ->
        {:error, Refusal.new(:beam4pm_timeout, "beam4pm request timed out", details: %{url: url})}

      {:error, reason} ->
        {:error, Refusal.new(:beam4pm_unavailable, "beam4pm request failed", details: %{url: url, reason: inspect(reason)})}
    end
  end

  defp standing_for(response) do
    if identity_from(response) do
      :alive
    else
      :partial_alive
    end
  end

  defp identity_from(%{"meta" => %{"source_sha" => sha, "receipt_verified" => true}}) when is_binary(sha) do
    %{source_sha: sha, receipt_verified: true}
  end

  defp identity_from(_response), do: nil
end
