    stl:hasStanding stl:DERIVED .

ex4pmal:claim_allen_temporal_t1 a stl:StandingTransition ;
    stl:aboutClaim ex4pmal:claim_allen_temporal ;
    stl:fromState stl:UNKNOWN ; stl:toState stl:OBSERVED ; stl:transitionOrder 1 ;
    stl:evidenceRef "OBSERVED: epm:AllenTemporal (algorithmId allen_temporal) is declared in the vendored ex4pm-wasm4pm-bindings-pack ontology (identity: ex4pmal:pack_ex4pm_wasm4pm_bindings_pack in priv/ggen/vendor/provenance.ttl) and adapter lib/ex4pm_engine/wasm/allen_temporal.ex declares the same wasm_export (asserted by generated test/algo_registry_test.exs)." .

ex4pmal:claim_allen_temporal_t2 a stl:StandingTransition ;
