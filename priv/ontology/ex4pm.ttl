@prefix ex4pm: <https://chatman.ai/ex4pm#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

ex4pm:Observation a rdfs:Class .
ex4pm:EventLog a rdfs:Class ; rdfs:subClassOf ex4pm:Observation .
ex4pm:Event a rdfs:Class ; rdfs:subClassOf ex4pm:Observation .
ex4pm:Object a rdfs:Class .
ex4pm:ProcessModel a rdfs:Class ; rdfs:subClassOf prov:Entity .
ex4pm:Engine a rdfs:Class ; rdfs:subClassOf prov:SoftwareAgent .
ex4pm:Capability a rdfs:Class .
ex4pm:Intent a rdfs:Class ; rdfs:subClassOf prov:Plan .
ex4pm:Authority a rdfs:Class ; rdfs:subClassOf prov:Entity .
ex4pm:Actuation a rdfs:Class ; rdfs:subClassOf prov:Activity .
ex4pm:Receipt a rdfs:Class ; rdfs:subClassOf prov:Entity .
ex4pm:Refusal a rdfs:Class ; rdfs:subClassOf prov:Entity .

ex4pm:subjectHash a rdf:Property ; rdfs:range xsd:string .
ex4pm:artifactHash a rdf:Property ; rdfs:range xsd:string .
ex4pm:activity a rdf:Property ; rdfs:domain ex4pm:Event ; rdfs:range xsd:string .
ex4pm:timestamp a rdf:Property ; rdfs:domain ex4pm:Event ; rdfs:range xsd:dateTime .
ex4pm:relatesObject a rdf:Property ; rdfs:domain ex4pm:Event ; rdfs:range ex4pm:Object .
ex4pm:hasModel a rdf:Property ; rdfs:range ex4pm:ProcessModel .
ex4pm:executedBy a rdf:Property ; rdfs:range ex4pm:Engine .
ex4pm:requiresAuthority a rdf:Property ; rdfs:range ex4pm:Authority .
ex4pm:hasReceipt a rdf:Property ; rdfs:range ex4pm:Receipt .
ex4pm:standing a rdf:Property ; rdfs:range xsd:string .
ex4pm:operation a rdf:Property ; rdfs:range xsd:string .

ex4pm:UNKNOWN a ex4pm:Capability .
ex4pm:PARTIAL_ALIVE a ex4pm:Capability .
ex4pm:ALIVE a ex4pm:Capability .
ex4pm:BLOCKED a ex4pm:Capability .
ex4pm:BUILD_BROKEN a ex4pm:Capability .
ex4pm:UNSUPPORTED a ex4pm:Capability .

# =============================================================================
# ggen_igniter admission graph: Ex4pm.Standing.Coded (docs/PRD-v26.9.10.md R1).
# Real production reason-coded standings observed in beam4pm's own
# scheduled-task receipts (STANDING[REASON_CODE] shape, e.g.
# ALIVE[WS3_CHICAGO_MERGE_50]) -- ex4pm's own bare-atom Ex4pm.Standing has
# no reason-code payload, so beam4pm invented its own bracket convention
# outside ex4pm's vocabulary. This admits the vocabulary itself into
# ex4pm's own ontology, same pattern as beam4pm's bpma:AdmittedActuation/
# bpmi:AdmittedIngestRoute admission graphs.
# =============================================================================
@prefix ex4pmsc: <https://chatman.ai/ex4pm/standing-coded#> .

ex4pmsc:alive_ws3_chicago_merge_50 a ex4pmsc:AdmittedStandingCode ;
    ex4pmsc:standing "alive" ;
    ex4pmsc:code "WS3_CHICAGO_MERGE_50" .

ex4pmsc:partial_alive_merged_local_capsule_namespace_unavailable
    a ex4pmsc:AdmittedStandingCode ;
    ex4pmsc:standing "partial_alive" ;
    ex4pmsc:code "MERGED_LOCAL_CAPSULE_NAMESPACE_UNAVAILABLE" .

ex4pmsc:build_broken_takt_shortfall a ex4pmsc:AdmittedStandingCode ;
    ex4pmsc:standing "build_broken" ;
    ex4pmsc:code "TAKT_SHORTFALL" .

ex4pmsc:alive_ws3_fortune5_runtime_value_50 a ex4pmsc:AdmittedStandingCode ;
    ex4pmsc:standing "alive" ;
    ex4pmsc:code "WS3_FORTUNE5_RUNTIME_VALUE_50" .

# =============================================================================
# ggen_igniter admission graph: Ex4pm.Engine.Beam4pm's admitted JSON:API
# service contract (docs/EX4PM-THINNING-BEAM4PM-ENRICHMENT.md, "zero
# config" redesign). Per the user's explicit direction: beam4pm is an Ash
# app; ex4pm connects to it as a generic AshJsonApi client, and the
# CONTRACT (which operations map to which beam4pm JSON:API resource
# type/action) is admitted ontology data, generated via `mix
# ex4pm.ggen.sync` -- not hand-wired per-service Elixir code. A new
# admitted service needs a new ex4pmb:AdmittedBeam4pmService individual +
# a re-sync, never a new function.
#
# HONEST STATUS, verified 2026-09-09 against the real ~/beam4pm checkout:
# `ash_json_api` IS present in beam4pm's mix.lock (pulled transitively,
# non-optionally, via `ash_ai`'s own spec), and the resources named below
# (BeamPM.Ash.Resources.OcelEvent, BeamPM.Ash.Resources.ConformanceResult)
# ARE real, already-defined Ash resources under
# ~/beam4pm/lib/beam4pm_ash/resources/. But zero resources currently
# declare a `json_api do ... end` block and no AshJsonApi.Router is
# mounted anywhere in beam4pm's Application/router -- so these routes are
# NOT live today. This is a forward-declared contract (the Phase 0
# beam4pm-side prerequisite from EX4PM-THINNING-BEAM4PM-ENRICHMENT.md
# section 4), admitted here so the ex4pm-side generated client exists and
# is tested against a real local JSON:API-shaped server now, ready to
# point at beam4pm's real endpoint the moment that Phase 0 work lands.
#
# CORRECT BY CONSTRUCTION, not runtime-verified (explicit user correction,
# 2026-09-09): the plan is NOT for ex4pm to fetch beam4pm's live OpenAPI
# spec and check for drift at runtime. It is for beam4pm's own future
# ggen_igniter pipeline (see docs/BEAM4PM-OPENAPI-GGEN-IGNITER-PLAN.md) to
# generate its `json_api do ... end` blocks from this EXACT SAME
# ex4pmb:AdmittedBeam4pmService graph -- the identical mechanism beam4pm
# already proves works today for merging a vendored pack's ontology.ttl
# with its own before querying (scripts/igniter_sync.sh's MERGED_TTL
# step). Once both Ex4pm.Engine.Beam4pm (this repo) and beam4pm's
# generated json_api routes are pure functions of byte-identical ontology
# input, they cannot disagree -- agreement is structural, the same
# guarantee Ex4pm.Contracts.manifest/0's content hash already gives any
# consumer of this whole file. No drift-detection refusal is needed or
# should be built; the correct fix for potential drift is ensuring
# beam4pm's generation step reads this file (or the exact ex4pmb: graph
# within it), not a runtime check against what it happens to have read.
#
# CONTRACT SHAPE CORRECTED, 2026-09-09, against a REAL local AshJsonApi
# instance (test/support/micro_beam4pm.ex -- a real Ash.Resource + real
# AshJsonApi.Router, not a hand-guessed fake), per the user's own request
# to test contracts with real ggen_igniter/Ash machinery before beam4pm
# builds against them. Real AshJsonApi routes are METHOD + PATH only
# (`index :read` + `base "/ocel_event"` => a plain `GET /ocel_event`) --
# there is NO query-string `action` parameter in the real wire protocol,
# because the route itself already implies the action, the same way any
# REST verb does. ex4pmb:actionName stays in this graph as informational/
# evidence metadata only (which Ash action a route maps to, useful for
# beam4pm's own generation step and for logging) -- it is no longer sent
# over the wire by Ex4pm.Engine.Beam4pm's real request/6. This is exactly
# the kind of wrong assumption a real local contract test was meant to
# catch before beam4pm built against it.
# =============================================================================
@prefix ex4pmb: <https://chatman.ai/ex4pm/beam4pm-services#> .

ex4pmb:ocel_event_query a ex4pmb:AdmittedBeam4pmService ;
    ex4pmb:operation "beam4pm_ocel_events" ;
    ex4pmb:jsonApiType "ocel_event" ;
    ex4pmb:actionName "read" ;
    ex4pmb:httpMethod "GET" ;
    rdfs:comment "Targets BeamPM.Ash.Resources.OcelEvent's default :read action once beam4pm mounts AshJsonApi. NOT live yet -- see ex4pmb: prefix comment above." .

ex4pmb:conformance_result_query a ex4pmb:AdmittedBeam4pmService ;
    ex4pmb:operation "beam4pm_conformance_results" ;
    ex4pmb:jsonApiType "conformance_result" ;
    ex4pmb:actionName "read" ;
    ex4pmb:httpMethod "GET" ;
    rdfs:comment "Targets BeamPM.Ash.Resources.ConformanceResult's default :read action once beam4pm mounts AshJsonApi. NOT live yet -- see ex4pmb: prefix comment above." .

# -----------------------------------------------------------------------
# Ferroplan planning capabilities, admitted 2026-09-10 as MORE beam4pm
# services -- not a new sub-prefix or a new Ex4pm.Engine.* module. Per the
# user's explicit correction: ex4pm (and ash_ex4pm by proxy, since it only
# ever talks to ex4pm) is a facade over beam4pm; beam4pm is the substrate.
# ex4pmb:AdmittedBeam4pmService already models exactly this facade shape,
# so ferroplan's native hierarchical/FOND capabilities extend that same
# graph and are served by the same Ex4pm.Engine.Beam4pm route table.
#
# Two new OPTIONAL predicates on ex4pmb:AdmittedBeam4pmService, additive --
# the two individuals above simply don't set them:
#   ex4pmb:planningType  -- ferroplan's PlanningType variant this maps to
#   ex4pmb:status         -- "forward_declared" | "live" honesty gate
#
# EVIDENCE (investigated 2026-09-10 directly against beam4pm's real
# source, not doc-trusting): beam4pm's ferroplan core crate
# (native/ferroplan/crates/ferroplan/src/planning_runtime.rs) has real,
# tested PlanningType::Hierarchical (hierarchical_plan(), recursive
# task/method decomposition) and PlanningType::Fond (fond_policy(), a
# strong FOND fixed point over PPDDL `oneof` non-deterministic effects --
# see planning_types.rs, ppddl/syntax/part04.rs, tests/planning_runtime.rs
# line 133). NEITHER is reachable today: ferroplan-wasm's dispatch() table
# (crates/ferroplan-wasm/src/wasi_abi.rs, lines 279-317, the complete
# 29-op list) and its 1:1 Elixir mirror (lib/beam4pm_ferroplan.ex) expose
# only the classical/temporal Session PDDL surface -- zero hierarchical/
# Fond terms anywhere in that ABI. HONEST STATUS: these two individuals
# are forward-declared exactly like ocel_event_query/
# conformance_result_query above -- reachable only once beam4pm (a)
# extends ferroplan-wasm's dispatch() with hierarchical_plan/fond_policy
# ops and (b) mounts matching json_api routes. That beam4pm-side work is
# tracked separately; this admission exists so ex4pm's generated facade
# client and contract tests are ready the moment it lands, same
# CORRECT-BY-CONSTRUCTION discipline as the rest of this graph.
# -----------------------------------------------------------------------
ex4pmb:planningType a rdf:Property ; rdfs:domain ex4pmb:AdmittedBeam4pmService ; rdfs:range xsd:string .
ex4pmb:status a rdf:Property ; rdfs:domain ex4pmb:AdmittedBeam4pmService ; rdfs:range xsd:string .

ex4pmb:ferroplan_hierarchical_plan a ex4pmb:AdmittedBeam4pmService ;
    ex4pmb:operation "ferroplan_hierarchical_plan" ;
    ex4pmb:jsonApiType "hierarchical_plan" ;
    ex4pmb:actionName "create" ;
    ex4pmb:httpMethod "POST" ;
    ex4pmb:planningType "Hierarchical" ;
    ex4pmb:status "forward_declared" ;
    rdfs:comment "Recursive task/method decomposition (ferroplan core planning_runtime.rs::hierarchical_plan, PlanningType::Hierarchical). Reachable only once beam4pm extends ferroplan-wasm's dispatch() table with a hierarchical_plan op AND mounts a matching json_api route -- same forward-declaration discipline as this graph's existing beam4pm_conformance_results/beam4pm_ocel_events entries. NOT live yet." .

ex4pmb:ferroplan_fond_policy a ex4pmb:AdmittedBeam4pmService ;
    ex4pmb:operation "ferroplan_fond_policy" ;
    ex4pmb:jsonApiType "fond_policy" ;
    ex4pmb:actionName "create" ;
    ex4pmb:httpMethod "POST" ;
    ex4pmb:planningType "Fond" ;
    ex4pmb:status "forward_declared" ;
    rdfs:comment "Strong FOND fixed-point policy over PPDDL oneof effects (ferroplan core planning_runtime.rs::fond_policy, PlanningType::Fond). Not yet reachable via ferroplan-wasm or a beam4pm json_api route. NOT live yet." .
